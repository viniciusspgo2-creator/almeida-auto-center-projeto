# ==========================================================
# BANCO DE DADOS (Neon PostgreSQL)
# Copie o valor do painel do Neon: Dashboard → Connection Details
# Formato esperado:
#   postgresql://usuario:senha@host/banco?sslmode=require
# Dica: no Neon, use o endpoint DIRETO (não o "-pooler") para
# funcionar tanto no build (db push) quanto no runtime.
# ==========================================================
DATABASE_URL=postgresql://usuario:senha@ep-host-123.neon.tech/meubanco?sslmode=require

# URL canônica do site (opcional — também pode ser definida no painel /admin, aba SEO)
NEXT_PUBLIC_SITE_URL=https://seudominio.com.br
